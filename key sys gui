local function createButton(text,y,border)
    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.Position = UDim2.new(0, 28, 0, y)
    btn.Size = UDim2.new(1, -56, 0, 55)
    btn.BackgroundColor3 = Color3.fromRGB(20,26,38)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(190,220,255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 20
    btn.BorderSizePixel = border and 2 or 0
    btn.BorderColor3 = Color3.fromRGB(60,150,255)

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    return btn
end

