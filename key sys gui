local function makeButton(text,y,outline)
	local btn = Instance.new("TextButton")
	btn.Parent = frame
	btn.Position = UDim2.new(0,25,0,y)
	btn.Size = UDim2.new(1,-50,0,48)
	btn.BackgroundColor3 = Color3.fromRGB(20,26,38)
	btn.Text = text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 18
	btn.TextColor3 = Color3.fromRGB(190,220,255)
	btn.BorderSizePixel = outline and 2 or 0
	btn.BorderColor3 = Color3.fromRGB(55,145,255)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,10)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn,TweenInfo.new(.2),{
			BackgroundColor3 = Color3.fromRGB(28,35,50)
		}):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(btn,TweenInfo.new(.2),{
			BackgroundColor3 = Color3.fromRGB(20,26,38)
		}):Play()
	end)

	return btn
end

