--// 24-HOUR KEY MEMORY SYSTEM
local KEY_SAVE_FILE = "vision_key_time.txt"
local KEY_VALID_DURATION = 24 * 60 * 60 -- 24 hours

local function hasValidKey()
    if not isfile or not readfile then
        return false
    end

    if not isfile(KEY_SAVE_FILE) then
        return false
    end

    local saved = tonumber(readfile(KEY_SAVE_FILE))
    if not saved then
        return false
    end

    return (os.time() - saved) < KEY_VALID_DURATION
end

local function saveKeyTime()
    if writefile then
        writefile(KEY_SAVE_FILE, tostring(os.time()))
    end
end

