-- UNIVERSAL UNIVERSE LOADER

local GameId = game.GameId

local GameScripts = {
    [5661134200] = "https://raw.githubusercontent.com/lllllllllllllllllllllIl/Tnf/refs/heads/main/free%20gui",        -- Track N Field
    [987654321]  = "https://raw.githubusercontent.com/USER/REPO/main/hoops.lua",
}

local function Load(url)
    local success, err = pcall(function()
        loadstring(game:HttpGet(url, true))()
    end)

    if not success then
        warn("[LOADER ERROR]:", err)
    end
end

if GameScripts[GameId] then
    Load(GameScripts[GameId])
else
    warn("No script mapped for UniverseId:", GameId)
end
